# Supabase — supabase.com 프로젝트 생성 후 값 채우기 (docs/prompts/02-migrate-and-auth.md 단계)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# 비밀번호 재설정 메일 등에서 콜백 URL을 만들 때 쓰는 우리 앱 주소
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# AI 기능(단어장 뜻풀이, 문제 생성, 리뷰 초안) — console.anthropic.com에서 발급
ANTHROPIC_API_KEY=

# 이메일 알림(073) — 어떤 SMTP 제공자든 가능 (Postmark/SendGrid SMTP 릴레이, Gmail Workspace 등)
# 로컬 개발은 supabase config.toml의 local_smtp(Mailpit)를 그대로 쓰면 됨(인증 불필요)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# 계약서 서명(072) — DocuSign JWT Grant. developer 계정: admindemo.docusign.com,
# 프로덕션: apps.docusign.com 의 "Apps and Keys"에서 확인. Base URI/Auth Server는
# 계정 종류(개발자 vs 프로덕션)에 따라 다르므로 /oauth/userinfo로 직접 확인해서 채울 것.
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_URI=
DOCUSIGN_AUTH_SERVER=
DOCUSIGN_PRIVATE_KEY=
# 서명 완료 웹훅(/api/webhooks/docusign) 검증용 임의 토큰 — openssl rand -hex 32 등으로 생성
DOCUSIGN_WEBHOOK_TOKEN=

# 수업권 결제(071) — dashboard.stripe.com에서 발급
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 선생님 Google Workspace 프로비저닝(R2 Task 7) — 전부 비밀이 아닌 식별자만.
# 실제 비밀(서비스 계정 키, OAuth Client Secret)은 여기 두지 않는다 —
# 인증 체인 자체가 Vercel OIDC → GCP WIF → 서비스 계정 impersonation →
# signJwt(DWD)라 장기 비밀이 없는 것이 설계 목표다. Google OAuth Client
# Secret은 Supabase Auth 프로바이더 설정에만 저장한다.
GOOGLE_WORKLOAD_IDENTITY_AUDIENCE=
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WORKSPACE_DELEGATED_ADMIN_EMAIL=
# 쓰기(계정 생성·정지·재활성화) 호출 허용 — Production에서만, 인프라 검증
# 완료 후 별도 승인 시에만 켠다. Preview에서는 이 값과 무관하게 항상 차단.
WORKSPACE_PROVISIONING_ALLOW_REAL_CALLS=false
# 읽기 전용 조회(preflight) 허용 — 쓰기 플래그와 독립적으로 동작하며,
# preflight 라우트는 이 값 외에도 Production 환경인지를 별도로 확인한다.
# 검증이 끝나면 기본값(false)으로 되돌리는 것을 원칙으로 한다.
WORKSPACE_PREFLIGHT_ALLOW_REAL_READS=false
# 로컬 개발에서만 쓰는 선생님 Google 로그인 테스트용 OAuth Client Secret
# (supabase/config.toml의 auth.external.google이 참조). 운영 Client와는
# 별개의 Client여야 한다 — 운영 Client Secret은 Supabase 대시보드에만
# 저장하고 여기 두지 않는다.
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# 초기 고객 절차 단순화(2026-09-28) — contract_dispatch_jobs outbox의 실제
# DocuSign 발송을 켠다. 기본값은 꺼짐(미설정 또는 "true" 외 값)이며, 꺼져
# 있어도 큐(대기 작업)는 계속 쌓인다 — 실제 고객 이메일·계약 발송만 막는다.
# 활성화는 실제 고객 발송을 의미하므로 별도 승인 후에만 "true"로 켠다.
CONTRACT_AUTO_DISPATCH_ENABLED=false

# ---- 아래는 2026-09-29 누락분 보강 — 실제 비밀값은 절대 커밋하지 않는다 ----

# Vercel Cron 인증 토큰(필수: 크론 라우트 전부) — openssl rand -hex 32 등으로 생성. 미설정이면 크론 호출이 거부된다.
CRON_SECRET=
# 강사 정산 승인건 자동 송금 크론 — "true"일 때만 동작(기본 꺼짐). 실제 송금이므로 별도 승인 후에만 켠다.
PAYOUT_CRON_ENABLED=false
# 개인정보 보존·삭제 배치 크론 — "true"일 때만 동작(기본 꺼짐). 실제 삭제이므로 별도 승인 후에만 켠다.
RETENTION_BATCH_ENABLED=false
# Google Calendar/Meet·Workspace Events 구독 실제 호출 허용 — "true"일 때만 외부 호출(기본 꺼짐).
CALENDAR_SYNC_ALLOW_REAL_CALLS=false
# DocuSign 샌드박스 실제 호출 허용 — "true"일 때만 외부 호출(기본 꺼짐).
DOCUSIGN_SANDBOX_ALLOW_REAL_CALLS=false
# 상담·미팅 산출물을 Google Drive 공유 드라이브에 실제로 쓰기 — "true"일 때만(기본 꺼짐).
DRIVE_ARTIFACTS_ALLOW_REAL_WRITES=false
# 회사 문서 관리(관리자) — 사용 시 세 값 모두 필요. ENABLED 가 "true"가 아니면 기능 비활성.
COMPANY_DOCUMENTS_ENABLED=false
# 회사 문서 공유 드라이브 ID(COMPANY_DOCUMENTS_ENABLED=true 일 때 필수)
COMPANY_DOCUMENTS_DRIVE_ID=
# 회사 문서 루트 폴더 ID(선택 — 비우면 드라이브 루트 사용)
COMPANY_DOCUMENTS_ROOT_FOLDER_ID=
# 컨설팅 미팅 주최자 이메일(선택 — 기본 official@alton.education)
CONSULT_ORGANIZER_EMAIL=
# Workspace Events Pub/Sub 토픽 전체 이름 projects/<id>/topics/<name> (구독 생성 시 필수)
WORKSPACE_EVENTS_PUBSUB_TOPIC=
# Pub/Sub push 웹훅(/api/webhooks/workspace-events) OIDC audience — 웹훅 URL 과 동일 값(웹훅 사용 시 필수)
WORKSPACE_EVENTS_PUSH_AUDIENCE=
# Pub/Sub push 서명 서비스 계정 이메일(웹훅 사용 시 필수)
WORKSPACE_EVENTS_PUSH_SERVICE_ACCOUNT_EMAIL=
# Vercel Preview 보호 우회 시크릿(선택 — 자동화 스크립트가 보호된 Preview 를 호출할 때만)
VERCEL_AUTOMATION_BYPASS_SECRET=
# Vercel 이 자동 주입하는 값(로컬에선 비워 둔다, 수동 설정 불필요). 배포 환경 판별·Preview 검증에 사용
VERCEL_ENV=
NEXT_PUBLIC_VERCEL_ENV=
VERCEL_GIT_COMMIT_REF=
VERCEL_GIT_REPO_OWNER=
VERCEL_PROJECT_ID=

# ---- 스크립트·테스트 전용(앱 런타임에서는 사용 안 함, 선택) ----
# top50 대학 시드 스크립트용 서비스 롤 키(로컬/개발 프로젝트 것만)
SUPABASE_SERVICE_ROLE_KEY=
# UAT 문제은행 시드 스크립트용
UAT_SERVICE_ROLE_KEY=
UAT_EXISTING_TEACHER_ID=
# UAT 매트릭스 산출물 기록 — 설정하면 파일을 쓴다(기본 꺼짐)
UAT_MATRIX_WRITE=
# 실제 AI 호출 스모크 테스트 — "1"일 때만 실행(비용 발생, 기본 꺼짐)
ALTON_AI_SMOKE=
# 통합 테스트 대상 로컬 Supabase(미설정 시 127.0.0.1 기본값)
SUPABASE_TEST_API_URL=
SUPABASE_TEST_DB_URL=
# 문제 도형 템플릿 샘플 HTML 출력 경로(설정 시에만 파일 생성)
T2_SAMPLES_OUT=
T3_SAMPLES_OUT=
T4_SAMPLES_OUT=
T5_SAMPLES_OUT=
T6_SAMPLES_OUT=
T8_SAMPLES_OUT=
