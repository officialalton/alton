# ~/.alton-secrets/prod.env 템플릿(저장소 밖, chmod 600). 값은 채우되 어디에도 커밋·출력하지 않는다.
# 새 운영 Supabase 프로젝트 정보
PROD_PROJECT_REF=
PROD_DB_PASSWORD=
# Supabase 대시보드 > Connect > Session pooler(5432) 문자열. 비밀번호에 특수문자가 있으면 URL 인코딩.
PROD_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-us-west-2.pooler.supabase.com:5432/postgres
PROD_SUPABASE_URL=https://<ref>.supabase.co
PROD_SUPABASE_SECRET_KEY=
# 비프로덕션(읽기 전용 내보내기용)
SOURCE_SUPABASE_URL=https://worpsqwqgnspddnrtnvq.supabase.co
SOURCE_SUPABASE_SECRET_KEY=
SOURCE_DB_URL=
