  "designNotes": "The CED has no numbered topics: nine units (Short Fiction I/II/III = units 1/4/7, Poetry I/II/III = 2/5/8, Longer Fiction or Drama I/II/III = 3/6/9) are defined by the skills 1.A-7.E in seven skill categories. Topic codes here are ALTON-assigned U<unit>.<n>, each grouping official skills from that unit's skill list (Course at a Glance). Unit and topic titles and sub-keywords are ALTON labels. Topic U9.4 (timed essays) is an ALTON addition for FRQ practice, not an official unit topic. Exam (docs/ap/englit-facts.md): 55 MC / 60 min / 45% = 5 passage sets of 8-13 questions (>= 2 prose fiction or drama, >= 2 poetry); 3 FRQ / 2 hours / 55% = poetry analysis, prose fiction analysis, literary argument (6 points each, analytic rubric: thesis 0-1, evidence and commentary 0-4, sophistication 0-1). MC weights: skill categories (see weights) and genre groups Short Fiction 42-49%, Poetry 36-45%, Longer Fiction or Drama 15-18% (genre groups are enforced in lib/ap-exam/englit-rules.ts, not as per-unit weights). Digital delivery (Bluebook)."
 },
 "skills": [
  {
   "code": "1.A",
   "category": "Character",
   "label": "Identify and describe what specific textual details reveal about a character, that character's perspective, and that character's motives."
  },
  {
   "code": "1.B",
   "category": "Character",
   "label": "Explain the function of a character changing or remaining unchanged."
  },
  {
   "code": "1.C",
   "category": "Character",
   "label": "Explain the function of contrasting characters."
  },
  {
   "code": "1.D",
   "category": "Character",
   "label": "Describe how textual details reveal nuances and complexities in characters' relationships with one another."
  },
  {
   "code": "1.E",
   "category": "Character",
   "label": "Explain how a character's own choices, actions, and speech reveal complexities in that character, and explain the function of those complexities."
  },
  {
   "code": "2.A",
   "category": "Setting",
   "label": "Identify and describe specific textual details that convey or reveal a setting."
  },
  {
   "code": "2.B",
   "category": "Setting",
   "label": "Explain the function of setting in a narrative."
  },
  {
   "code": "2.C",
   "category": "Setting",
   "label": "Describe the relationship between a character and a setting."
  },
  {
   "code": "3.A",
   "category": "Plot and Structure",
   "label": "Identify and describe how plot orders events in a narrative."
  },
  {
   "code": "3.B",
   "category": "Plot and Structure",
   "label": "Explain the function of a particular sequence of events in a plot."
  },
  {
   "code": "3.C",
   "category": "Plot and Structure",
   "label": "Explain the function of structure in a text."
  },
  {
   "code": "3.D",
   "category": "Plot and Structure",
   "label": "Explain the function of contrasts within a text."
  },
  {
   "code": "3.E",
   "category": "Plot and Structure",
   "label": "Explain the function of a significant event or related set of significant events in a plot."
  },
  {
   "code": "3.F",
   "category": "Plot and Structure",
   "label": "Explain the function of conflict in a text."
  },
  {
   "code": "4.A",
   "category": "Narrator or Speaker",
   "label": "Identify and describe the narrator or speaker of a text."
  },
  {
   "code": "4.B",
   "category": "Narrator or Speaker",
   "label": "Identify and explain the function of point of view in a narrative."
  },
  {
   "code": "4.C",
   "category": "Narrator or Speaker",
   "label": "Identify and describe details, diction, or syntax in a text that reveal a narrator's or speaker's perspective."
  },
  {
   "code": "4.D",
   "category": "Narrator or Speaker",
   "label": "Explain how a narrator's reliability affects a narrative."
  },
  {
   "code": "5.A",
   "category": "Word Choice, Imagery, and Symbols",
   "label": "Distinguish between the literal and figurative meanings of words and phrases."
  },
  {
   "code": "5.B",
   "category": "Word Choice, Imagery, and Symbols",
   "label": "Explain the function of specific words and phrases in a text."
  },
  {
   "code": "5.C",
   "category": "Word Choice, Imagery, and Symbols",
   "label": "Identify and explain the function of a symbol."
  },
  {
   "code": "5.D",
   "category": "Word Choice, Imagery, and Symbols",
   "label": "Identify and explain the function of an image or imagery."
  },
  {
   "code": "6.A",
   "category": "Comparison",
   "label": "Identify and explain the function of a simile."
  },
  {
   "code": "6.B",
   "category": "Comparison",
   "label": "Identify and explain the function of a metaphor."
  },
  {
   "code": "6.C",
   "category": "Comparison",
   "label": "Identify and explain the function of personification."
  },
  {
   "code": "6.D",
   "category": "Comparison",
   "label": "Identify and explain the function of an allusion."
  },
  {
   "code": "7.A",
   "category": "Literary Argumentation",
   "label": "Develop a paragraph that includes 1) a claim that requires defense with evidence from the text and 2) the evidence itself."
  },
  {
   "code": "7.B",
   "category": "Literary Argumentation",
   "label": "Develop a thesis statement that conveys a defensible claim about an interpretation of literature and that may establish a line of reasoning."
  },
  {
   "code": "7.C",
   "category": "Literary Argumentation",
   "label": "Develop commentary that establishes and explains relationships among textual evidence, the line of reasoning, and the thesis."
  },
  {
   "code": "7.D",
   "category": "Literary Argumentation",
   "label": "Select and use relevant and sufficient evidence to both develop and support a line of reasoning."
  },
  {
   "code": "7.E",
   "category": "Literary Argumentation",
   "label": "Demonstrate control over the elements of composition to communicate clearly."
  }
